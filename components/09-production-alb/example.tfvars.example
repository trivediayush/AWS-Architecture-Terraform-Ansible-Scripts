aws_region = "ap-south-1"
project_name = "sunroof"
environment = "production"
vpc_id = "" # empty = auto-read from 00-network
public_subnet_ids = [] # empty = auto-read from 00-network
alb_security_group_id = "" # empty = auto-read from 01-security-groups
target_port = 8080
target_type = "ip"
health_check_path = "/"
enable_access_logs = true
access_logs_bucket_name = "replace-with-globally-unique-alb-logs-bucket"
# Supply only after client approves the free certificate path and an IAM server certificate has been imported.
certificate_arn = ""
